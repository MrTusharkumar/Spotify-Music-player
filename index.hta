<!DOCTYPE html>
<html>
<head>
  	<meta charset="utf-8">
  	<meta name="viewport" content="initial-scale=1, width=device-width">
  	
  	
  	<link rel="stylesheet" href="style.css" />
  	<link rel="stylesheet"  href="./index.css" />
  	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto Sans Arabic:wght@400;700&display=swap" />
  	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@700&display=swap" />
  	
  	<title>Clone Spotify</title>
  	
</head>
<body>
    
  	<!-- Navbar -->
    		<div class="navbar">
                <div class="vector-parent">
        				<img class="vector-icon" alt="" src="./Assists/Vector.svg">
        				
        				<div class="rectangle-parent">
          					<div class="group-child">
          					</div>
          					<img class="vector-icon1" alt="" src="./Assists/Vector-1.svg">
          					
        				</div>
						<input class="search-bar search-bar-child  "  type="text" placeholder=" What do you want to play " id="fname" name="fname" required />
        				</div>
        				
      		
      			<div class="premume-parent">
        				<b class="premume">
          					<p class="premume1">Premume</p>
        				</b>
        				<b class="premume">Support</b>
        				<b class="premume">Download</b>
                        <div class=" line-icon"></div>
        				<div class="install-app">
          					<div class="install-app-child">
          					</div>
          					<b class="install-app1">Install App</b>
          					<img class="vector-icon3" alt="" src="./Assists/Vector-4.svg">
          					
        				</div>
        				<div class="sign-in">
          					<div class="sign-in-child">
          					</div>
          					<b class="sign-up">Sign up</b>
        				</div>
        				<div class="log-in">
          					<div class="log-in-child">
          					</div>
          					<b class="log-in1">Log in</b>
        				</div>
      			</div>
    		</div>

            <!-- Navbar-End -->

            <!-- Left-Side -->
           
    		<div class="left-side ">
				<div class="scroll_bar">Hello World </div>
                <div class="left-footer">
        				
        				<b class="legal">Legal</b>
        				<b class="safety-privacy">Safety & Privacy Center</b>
        				<b class="privacy-policy">Privacy Policy</b>
        				<b class="cookies">Cookies</b>
        				<b class="cookies1">Cookies</b>
        				<b class="about-ads">About Ads </b>
        				<b class="accessibility">Accessibility</b>
        				<div class="language-button">
          					<div class="language-button-child">
          					</div>
          					<div class="english">
            						<p class="premume1">English </p>
          					</div>
          					<img class="solarglobal-linear-icon" alt="" src="./Assists/solar_global-linear.svg">
          					
        				</div>
                    </div>
                    <div class="library">
                        <img class="vector-icon4" alt="" src="./Assists/Vector-3.svg">
        				
        				<b class="your-library">Your Library</b>
                    </div>
      			
    		</div>

            

            <!-- Left-Side End -->


            <!-- Right-Side -->
			<div class="right-side ">
				
				<div class="right-bg-icon">

                
                <div class="artist-group">
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<div class="play"><img src="./Assists/Play.svg" alt=""></div>
						<h2>Tushar</h2>

						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					

        			
					
        				<b class="popular-artists">Popular artists</b>
      			</div>
      			<div class="albume-group">
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>


        				<b class="pular-albums-and">&pular albums and singles</b>
      			</div>
      			<div class="popular-radio-group">
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
        				<b class="popular-radio">Popular radio</b>
      			</div>
				
      			<div class="popular-radio-group1">
					
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>
					<div class="artist-group-child">
						<img src="./Assists/Artist/IMG_20240125_193243_723.jpg" alt="">
						<h2>Tushar</h2>
						<p></p>
					</div>

        				<b class="popular-radio1">Popular radio</b>
					</div>

					<hr>
					
					<div class="footer">
						  
						  <b class="about">About</b>
						  <b class="for-artists">For Artists</b>
						  <b class="support1">Support</b>
						  <b class="premium-duo">Premium Duo</b>
						  <b class="premium-family">Premium Family</b>
						  <b class="premium-student">Premium Student</b>
						  <b class="spotify-free">Spotify Free</b>
						  <b class="premium-individual">Premium Individual</b>
						  <b class="free-mobile-app">Free Mobile App</b>
						  <b class="job">Job</b>
						  <b class="developers">Developers</b>
						  <b class="company">Company</b>
						  <b class="communities">Communities</b>
						  <b class="useful-links">Useful links</b>
						  <b class="spotily-plans">Spotily Plans</b>
						  <b class="advertising">Advertising</b>
						  <b class="investors">Investors</b>
						  <b class="vendors">Vendors</b>
						  <b class="for-the-record">For the Record</b>
						  <b class="spotify-ab">© 2025 Spotify AB</b>
						  <div class="rectangle-group">
								<div class="group-item">
								</div>
								<img class="mdiinstagram-icon" alt="" src="./Assists/mdi_instagram.svg">
								
						  </div>
						  <div class="rectangle-container">
								<div class="group-item">
								</div>
								<img class="mdiinstagram-icon" alt="" src="./Assists/ic_baseline-facebook.svg">
								
						  </div>
						  <div class="group-div">
								<div class="group-item">
								</div>
								<img class="mdilinkedin-icon" alt="" src="./Assists/mdi_linkedin.svg">
								
						  </div>
					  
					  
			</div>
		</div>
		
	</div>
    <!-- Right-Side End  -->
  	<script src="./script.js"></script>
  	
</body>
</html>